# Network interface to listen on with tcpdump
# Example: eth0, ens33
NETWORK_INTERFACE=eth0

# Optional output directory for generated PCAP files
# Default: data/raw/captures
CAPTURE_OUTPUT_DIR=data/raw/captures

# Optional output directory for CICFlowMeter CSV files
# Default: data/processed/flows
FLOW_OUTPUT_DIR=data/processed/flows

# Optional number of subscriber workers for CICFlowMeter processing
# Default: 1
FLOW_WORKER_COUNT=1

# Optional CICFlowMeter executable path/name
# Default: cicflowmeter
CICFLOWMETER_BIN=cicflowmeter

# Optional working directory for CICFlowMeter subprocesses
# Default: unset, uses the current Python process working directory
CICFLOWMETER_CWD=
