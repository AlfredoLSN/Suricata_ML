# Network interface to listen on with tcpdump
# Example: eth0, ens33
NETWORK_INTERFACE=eth0

# Optional output directory for generated PCAP files
# Default: data/raw/captures
CAPTURE_OUTPUT_DIR=data/raw/captures

# Optional output directory for CICFlowMeter CSV files
# Default: data/processed/flows
FLOW_OUTPUT_DIR=data/processed/flows

# Optional number of subscriber workers for CICFlowMeter processing
# Default: 1
FLOW_WORKER_COUNT=1

# Optional CICFlowMeter executable path/name
# Default: cicflowmeter
CICFLOWMETER_BIN=cicflowmeter

# Optional working directory for CICFlowMeter subprocesses
# Default: unset, uses the current Python process working directory
CICFLOWMETER_CWD=

# Optional classification step after each successful CICFlowMeter extraction
# Default: false
CLASSIFICATION_ENABLED=false

# Optional trained model path used to classify generated flow CSV files
# Default: modelo/pipeline.joblib
CLASSIFICATION_MODEL_PATH=modelo/pipeline.joblib

# Optional label encoder path used to decode numeric predictions
# Default: modelo/label_encoder.joblib
CLASSIFICATION_LABEL_ENCODER_PATH=modelo/label_encoder.joblib

# Optional output directory for classified flow CSV files
# Default: data/processed/classified_flows
CLASSIFIED_FLOW_OUTPUT_DIR=data/processed/classified_flows

# Optional comma-separated labels for numeric model outputs
# Example: BENIGN,DOS,PORTSCAN,BOT,INFILTRATION
CLASSIFICATION_LABELS=

# Optional comma-separated labels treated as non-malicious by IDS/IPS response
# Default: BENIGN,0
CLASSIFICATION_BENIGN_LABELS=BENIGN,0

# Optional source IP to remove before classification
# Example: 192.168.0.10
CLASSIFICATION_EXCLUDED_SRC_IP=

# Optional toggle for the source IP filter above
# Default: true
CLASSIFICATION_REMOVE_SRC_IP=true

# Optional IDS/IPS response after classification
# off: only classify and write CSV
# ids: send malicious-flow warnings to Telegram
# ips: block malicious source IPs in the firewall
# Default: off
THREAT_RESPONSE_MODE=off

# Required only when THREAT_RESPONSE_MODE=ids
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=15
TELEGRAM_RETRY_COUNT=3
TELEGRAM_RETRY_BACKOFF_SECONDS=2

# Used only when THREAT_RESPONSE_MODE=ips
# The service process must have permission to manage firewall rules.
FIREWALL_COMMAND=iptables
FIREWALL_CHAIN=INPUT
FIREWALL_TARGET=DROP
